# Copy to web/.env.local. Default network is testnet.
#
# Mainnet values, for reference (src/lib/near.ts uses these when NEXT_PUBLIC_NEAR_NETWORK=mainnet
# and the variables below are empty):
#   RPC                https://rpc.mainnet.fastnear.com, falls back to https://free.rpc.fastnear.com
#   MPC signer         v1.signer
#   Intents verifier   intents.near
#   USDC (native)      17208628f84f5d6ad33f0da3bbbeb27ffcb398eac501a31bd6ad2011e36133a1
#   Explorers          nearblocks.io, mempool.space, solscan.io, basescan.org
#
# Testnet has no intents.near and no 1Click, so customers pay in Test USDC with ft_transfer_call,
# and paying in any other token is mainnet only.

# NEAR network and contracts
NEXT_PUBLIC_NEAR_NETWORK=testnet
# Optional. Replaces the network's default RPC list (no fallback when set).
# Testnet defaults: https://test.rpc.fastnear.com, then https://rpc.testnet.near.org
NEXT_PUBLIC_NEAR_RPC_URL=
# Deployed incorpr-registry, for example registry.<your-account>.testnet
NEXT_PUBLIC_REGISTRY_CONTRACT_ID=
# Optional. Defaults: v1.signer-prod.testnet on testnet, v1.signer on mainnet.
NEXT_PUBLIC_MPC_CONTRACT_ID=
# Testnet: your deployed contracts/test-doubles/test-usdc ("Test USDC"), for example test-usdc.<your-account>.testnet
# Mainnet: leave empty for native USDC (17208628f84f5d6ad33f0da3bbbeb27ffcb398eac501a31bd6ad2011e36133a1)
NEXT_PUBLIC_USDC_CONTRACT_ID=
# Mainnet: leave empty for intents.near. Testnet has no deployment, so this names any stand-in the registry was configured with.
NEXT_PUBLIC_INTENTS_CONTRACT_ID=

# Operator: sends record_service_call and agent_swap_intent. Must match the vault's policy operator.
# Server only. Never prefix these with NEXT_PUBLIC_.
NEAR_OPERATOR_ACCOUNT_ID=
NEAR_OPERATOR_PRIVATE_KEY=

# NEAR AI Cloud. Unset API key: TEE routes answer HTTP 503.
NEAR_AI_CLOUD_URL=https://cloud-api.near.ai/v1
NEAR_AI_API_KEY=
# Must be a ready, nearai-owned model in GET /v1/models. Leave empty to pick one from the live list.
NEAR_AI_DEFAULT_MODEL=Qwen/Qwen3-VL-30B-A3B-Instruct
# Optional JSON object of model id to direct completions base URL, adding to the built-in map.
NEAR_AI_DIRECT_ENDPOINTS=

# NEAR Intents. The JWT lowers the 1Click fee and stays on the server.
NEAR_INTENTS_ONE_CLICK_URL=https://1click.chaindefuser.com/v0
NEAR_INTENTS_SOLVER_RPC_URL=https://solver-relay-v2.chaindefuser.com/rpc
NEAR_INTENTS_JWT=
# Mainnet only. /api/rebalance refuses to move real funds unless this is true.
INCORPR_ALLOW_MAINNET_REBALANCE=false

# L1 freshness overrides. Empty uses network-correct public endpoints:
# testnet: mempool testnet4, Base Sepolia, Ethereum Sepolia, Arbitrum Sepolia, Solana devnet.
# BTC_MEMPOOL_API takes a comma-separated failover list of Esplora-compatible APIs.
BTC_MEMPOOL_API=
BASE_RPC_URL=
ETHEREUM_RPC_URL=
ARBITRUM_RPC_URL=
SOLANA_RPC_URL=
