# Copy to video/.env (git-ignored). Only the scripts in video/scripts read this file.
# ElevenLabs key for narration, music and effects (scripts/voiceover.mjs, music.mjs, sfx.mjs, vocheck.mjs).
ELEVENLABS_API_KEY=
# Chrome binary for capture.mjs and look.mjs. Empty: /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
CHROME_PATH=
# App to record. Empty: http://localhost:3010
BASE=
